# Configure ARCHS4 version and path (edit ARCHS4_LOCAL_PATH to your local copy)
ARCHS4_VERSION = "2.latest"
ARCHS4_LOCAL_PATH = "/path/to/archs4"   # <-- set to folder that contains human_gene_v2.latest.h5

# Generally, filename and file should remain untouched
ARCHS4_FILENAME = f"human_gene_v{ARCHS4_VERSION}.h5"
ARCHS4_FILE = f"{ARCHS4_LOCAL_PATH}/{ARCHS4_FILENAME}"

# Configure size of ARCHS4 database
ROWS = 287553
COLS = 67186

# Configure location for the database creation workflow to store temporary files
TMP_FILE_PATH = "/path/to/tmp_folder"

# Configure location for the database creation workflow to store the final h5ad files
FINAL_FILES = "/path/to/final_files"

rule all:
    input:
        f"{FINAL_FILES}/results/semantic_db.h5ad",
        f"{FINAL_FILES}/results/transcriptomic_db.h5ad"

rule process_hdf5_file_for_ids:
    input:
        f"{ARCHS4_FILE}"
    output:
        f"{TMP_FILE_PATH}/results/metadata_geo_human.csv",
        f"{TMP_FILE_PATH}/results/arch_geo_superseries.csv",
        f"{TMP_FILE_PATH}/results/arch_geo_nosuperseries.csv",
        f"{TMP_FILE_PATH}/results/no_superseries_ids_only.csv",
        f"{TMP_FILE_PATH}/results/superseries_ids_only.csv"
    script:
        "scripts/extract_ids_from_hdf5.py"

rule download_single_series_from_geo:
    input:
        f"{TMP_FILE_PATH}/results/no_superseries_ids_only.csv"
    output:
        f"{TMP_FILE_PATH}/single_series",
        f"{TMP_FILE_PATH}",
        f"{TMP_FILE_PATH}/single_series/metadata_final.p"
    script:
        "scripts/single_series_geo_download.py"

rule download_super_series_from_geo:
    input:
        f"{TMP_FILE_PATH}/results/superseries_ids_only.csv"
    output:
        f"{TMP_FILE_PATH}/superseries",
        f"{TMP_FILE_PATH}",
        f"{TMP_FILE_PATH}/superseries/metadata_final.p"
    script:
        "scripts/super_series_geo_download.py"

rule combine_single_series:
    input:
        f"{TMP_FILE_PATH}/single_series"
    output:
        f"{TMP_FILE_PATH}/results/single_series.csv"
    script:
        "scripts/combine_singleseries.py"

rule combine_super_series:
    input:
        f"{TMP_FILE_PATH}/superseries",
        f"{TMP_FILE_PATH}/results/superseries_ids_only.csv"
    output:
        f"{TMP_FILE_PATH}/results/superseries.csv"
    script:
        "scripts/combine_superseries.py"

rule preprocess_series_information:
    input:
        f"{TMP_FILE_PATH}/results/single_series.csv",
        f"{TMP_FILE_PATH}/results/superseries.csv",
        f"{TMP_FILE_PATH}/results/arch_geo_superseries.csv",
    output:
        f"{TMP_FILE_PATH}/results/full_nosuperseries_with_pmid.csv",
        f"{TMP_FILE_PATH}/results/full_superseries_with_pmid.csv"
    script:
        "scripts/preprocess_series.py"

rule merge_series_information:
    input:
        f"{TMP_FILE_PATH}/results/full_nosuperseries_with_pmid.csv",
        f"{TMP_FILE_PATH}/results/full_superseries_with_pmid.csv"
    output:
        f"{TMP_FILE_PATH}/results/RAG.csv"
    script:
        "scripts/merge_for_rag.py"

rule create_embedding_and_index:
    input:
        f"{TMP_FILE_PATH}/results/RAG.csv"
    output:
        f"{TMP_FILE_PATH}/results/rag_index_v2.pkl",
        f"{TMP_FILE_PATH}/results/rag_embedding_matrix_v2.pkl"
    script:
        "scripts/create_rag_binaries.py"

rule create_semantic_h5ad:
    input:
        f"{TMP_FILE_PATH}/results/rag_embedding_matrix_v2.pkl",
        f"{TMP_FILE_PATH}/results/rag_index_v2.pkl"
    output:
        f"{FINAL_FILES}/results/semantic_db.h5ad"
    script:
        "scripts/create_semantic_h5ad.py"

rule create_aggregated_count_memmap:
    input:
        f"{ARCHS4_FILE}"
    params:
        rows = {ROWS}
        cols = {COLS}
        num_rows = {ROWS}
    output:
        f"{TMP_FILE_PATH}/results/study_counts.dat",
        f"{TMP_FILE_PATH}/results/transcription_index_v2.pkl"
    script:
        "scripts/create_aggregated_count_memmap.py"

rule jl_transform_count_matrix:
    input:
        f"{TMP_FILE_PATH}/results/study_counts.dat"
    params:
        rows = {ROWS}
        cols = {COLS}
    output:
        f"{TMP_FILE_PATH}/results/matrix_v2.pkl"
    script:
        "scripts/jl_transform.py"

rule create_gene_index:
    input:
        f"{ARCHS4_FILE}"
    output:
        f"{TMP_FILE_PATH}/results/genes_v2.p"
    script:
        "scripts/create_gene_index.py"

rule create_transcriptomic_db:
    input:
        f"{TMP_FILE_PATH}/results/transcription_index_v2.pkl",
        f"{TMP_FILE_PATH}/results/study_counts.dat",
        f"{TMP_FILE_PATH}/results/genes_v2.p"
    params:
        rows = {ROWS}
        cols = {COLS}
    output:
        f"{TMP_FILE_PATH}/results/transcription_embedding_matrix_v2.pkl"
        f"{FINAL_FILES}/results/transcriptomic_db.h5ad"
    script:
        "scripts/create_transcriptomic_db.py"

